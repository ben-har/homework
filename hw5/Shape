using System;

public abstract class Shape
{
    private string color;

    public string Color
    {
        get { return this.color; }
        set { this.color = value; }
    }

    public Shape(string Color)

    {
        this.color = Color;

    }

    public abstract int Area();


    public override string ToString()
    {
        return $"color is {Color}";

    }

}
public class Rectangle : Shape
{
    private int width;
    private int height;

    public int Width
    {
        get { return this.width; }
        set { this.width = value; }
    }
    public int Height
    {
        get { return this.height; }
        set { this.height = value; }
    }

    public Rectangle(int Width, int Height, string Color)
            : base(Color)
    {
        this.width = Width;
        this.height = Height;

    }
    public override int Area()
    {

        return Width * Height;

    }
    public override string ToString()
    {
        return $"shapes color is {Color}, the area is {Area()} ";



    }

}

public class Circle : Shape
{
    private int diameter;

    public int Diameter
    {
        get { return this.diameter; }
        set { this.diameter = value; }
    }

    public Circle(int Diameter,string  Color)
        :base(Color)
    {
        this.diameter = Diameter;
    }
    
    public override int Area()
    {
        return Diameter / 2;
    
    }

    public override string ToString()
    {

        return $"shapes color is {Color}, the circles radius is {Area()}  ";


    }
}
    public class program
    {
        public static void Main(string[] args)
        {
        Rectangle myrec = new Rectangle(10, 10, "blue");
        Console.WriteLine(myrec.ToString());

        Circle mycir = new Circle(50, "green");
        Console.WriteLine(mycir.ToString());
          



        }
        
    
    
    
    
    
